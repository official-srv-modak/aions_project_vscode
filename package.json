{
  "name": "aions-language-support",
  "displayName": "AIONS Language Support",
  "description": "Official language support and formatter for AIONS",
  "version": "1.0.12",
  "icon": "aion.png",
  "publisher": "official-srv-modak",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:aions"
  ],
  "main": "./out/main.js",
  "contributes": {
    "languages": [
      {
        "id": "aions",
        "aliases": ["AIONS", "aions", "aion", "AION"],
        "extensions": [".aion"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aions",
        "scopeName": "source.aions",
        "path": "./syntaxes/aions.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test-compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3",
    "esbuild": "^0.18.15"
  }
}