{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AIONS",
  "scopeName": "source.aions",
  "patterns": [
    {
      "name": "variable.parameter.aions",
      "match": "\\bsystem_prompt\\b",
      "comment": "Forces system_prompt to be Orange"
    },
    {
      "name": "entity.name.function.aions",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "comment": "Hijacked to force multi-line strings to be Yellow/Gold",
      "patterns": [
        {
          "name": "constant.character.escape.aions",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.double.aions",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aions",
          "match": "\\\\."
        },
        {
          "name": "keyword.control.link.aions",
          "match": "https?://[^\\s\"\\)\\]]+",
          "comment": "Hijacked to force purple/magenta in standard dark themes"
        }
      ]
    },
    {
      "name": "keyword.operator.assignment.aions",
      "match": "-->"
    },
    {
      "name": "support.type.property-name.aions",
      "match": "\\b(name|function|description|link|args_schema)\\b"
    },
    {
      "name": "variable.parameter.aions",
      "match": "\\b(arg-[0-9]+|return-[0-9]+)\\b"
    }
  ],
  "repository": {}
}